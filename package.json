{
  "name": "sonoite-theme",
  "version": "1.0.0",
  "description": "Standalone Vite site that performs the 7-track album Sonoite as audio-reactive Three.js chamber films",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .js,.jsx",
    "lint:check": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "test": "cross-env TMPDIR=/tmp jest --config jest.config.cjs",
    "test:full": "cross-env TMPDIR=/tmp jest --config jest.config.cjs",
    "test:watch": "cross-env TMPDIR=/tmp jest --watch --config jest.config.cjs",
    "test:coverage": "cross-env TMPDIR=/tmp jest --coverage --config jest.config.cjs",
    "audio:import": "node scripts/import-audio.mjs",
    "audio:check": "node scripts/check-audio.mjs",
    "deploy": "npm run audio:check && npm run build && npx netlify-cli deploy --prod --dir dist",
    "analyze:audio": "node scripts/analyze-audio.js",
    "analyze:merge": "node scripts/merge-analysis.js",
    "assets:track5:degold": "node scripts/clean-textured-glb.mjs --in public/assets/models/track5-poc/optimized/track5-relic-textured-optimized.glb --out public/assets/models/track5-poc/optimized/track5-relic-textured-clean.glb",
    "assets:track5:inspect": "gltf-transform inspect public/assets/models/track5-poc/optimized/track5-relic-generated-optimized.glb && gltf-transform inspect public/assets/models/track5-poc/optimized/track5-relic-textured-optimized.glb",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "validate": "npm run lint:check && npm run test && npm run security:audit",
    "validate:journeys": "node scripts/validate-journeys.cjs",
    "validate:journeys:strict": "node scripts/validate-journeys.cjs --strict",
    "validate:journeys:ci": "node scripts/validate-journeys.cjs --fail-on-unknown"
  },
  "keywords": [
    "three.js",
    "webgl",
    "web-audio",
    "audio-reactive",
    "music",
    "vite",
    "generative-art"
  ],
  "author": "Ricardo Remedio",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "meyda": "^5.6.3",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.5.1",
    "@wordpress/eslint-plugin": "^24.1.0",
    "audio-decode": "^2.2.3",
    "babel-jest": "^29.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "rimraf": "^5.0.0",
    "sharp": "^0.34.5",
    "terser": "^5.19.0",
    "vite": "^7.0.2",
    "wav-decoder": "^1.3.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    },
    "jest-environment-jsdom": {
      "jsdom": "^24.1.3"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "config": {
    "security": {
      "csp": true,
      "hsts": true,
      "nosniff": true,
      "xframe": true,
      "xss": true
    }
  }
}
