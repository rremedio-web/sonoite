{
  "name": "sonoite-theme",
  "version": "1.0.0",
  "description": "WordPress theme that performs a 7-track album as an audio-reactive Three.js chamber film",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .js,.jsx --fix",
    "lint:check": "eslint src --ext .js,.jsx",
    "test": "cross-env TMPDIR=/tmp jest --config jest.config.cjs",
    "test:full": "cross-env TMPDIR=/tmp jest --config jest.config.cjs --coverage=false --reporters=default",
    "test:watch": "cross-env TMPDIR=/tmp jest --watch --config jest.config.cjs",
    "test:coverage": "cross-env TMPDIR=/tmp jest --coverage --config jest.config.cjs",
    "analyze": "vite-bundle-analyzer",
    "deploy": "npm run clean && npm run build",
    "analyze:audio": "node scripts/analyze-audio.js",
    "analyze:merge": "node scripts/merge-analysis.js",
    "assets:track5:degold": "node scripts/clean-textured-glb.mjs --in public/assets/models/track5-poc/optimized/track5-relic-textured-optimized.glb --out public/assets/models/track5-poc/optimized/track5-relic-textured-clean.glb",
    "assets:track5:inspect": "gltf-transform inspect public/assets/models/track5-poc/optimized/track5-relic-generated-optimized.glb && gltf-transform inspect public/assets/models/track5-poc/optimized/track5-relic-textured-optimized.glb",
    "assets:track5:optimize": "mkdir -p public/assets/models/track5-poc/optimized && gltf-transform optimize public/assets/models/track5-poc/Meshy_AI_symbol_0307145856_generate.glb public/assets/models/track5-poc/optimized/track5-relic-generated-optimized.glb --compress quantize --texture-compress false --simplify true --simplify-ratio 0.35 --simplify-error 0.001 --texture-size 1024 && gltf-transform optimize public/assets/models/track5-poc/Meshy_AI_symbol_0307145845_texture.glb public/assets/models/track5-poc/optimized/track5-relic-textured-optimized.glb --compress quantize --texture-compress auto --simplify true --simplify-ratio 0.35 --simplify-error 0.001 --texture-size 1024",
    "wp:watch": "concurrently \"npm run build:watch\" \"wp-cli theme activate sonoite-theme\"",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "validate": "npm run lint:check && npm run test && npm run security:audit",
    "validate:journeys": "node scripts/validate-journeys.cjs",
    "validate:journeys:strict": "node scripts/validate-journeys.cjs --strict",
    "validate:journeys:ci": "node scripts/validate-journeys.cjs --fail-on-unknown",
    "build:static": "npm run build && node scripts/build-static-prototype.mjs",
    "export:static": "npm run build && node scripts/build-static-prototype.mjs"
  },
  "keywords": [
    "three.js",
    "webgl",
    "wordpress-theme",
    "web-audio",
    "audio-reactive",
    "music",
    "vite",
    "generative-art"
  ],
  "author": "Ricardo Remedio",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "audio-decode": "^2.1.5",
    "dompurify": "^3.0.5",
    "meyda": "^5.6.3",
    "three": "0.160.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@rollup/plugin-alias": "^5.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@wordpress/eslint-plugin": "^24.1.0",
    "babel-jest": "^29.0.0",
    "babel-loader": "^9.1.0",
    "check-node-version": "^4.0.0",
    "chrome-devtools-mcp": "^0.23.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^0.8.9",
    "eslint-plugin-security": "^1.7.1",
    "essentia.js": "^0.1.3",
    "express-rate-limit": "^6.0.0",
    "helmet": "^7.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "jest-html-reporters": "^3.1.4",
    "jest-junit": "^17.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "postcss": "^8.4.24",
    "raw-loader": "^4.0.2",
    "rimraf": "^5.0.0",
    "sharp": "^0.34.5",
    "snyk": "^1.1193.0",
    "terser": "^5.19.0",
    "terser-webpack-plugin": "^5.0.0",
    "vite": "^7.0.2",
    "vite-bundle-analyzer": "^0.7.0",
    "wav-decoder": "^1.3.0",
    "webpack": "^5.88.0",
    "webpack-bundle-analyzer": "^4.0.0",
    "webpack-cli": "^5.1.0",
    "webpack-subresource-integrity": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    },
    "jest-environment-jsdom": {
      "jsdom": "^24.1.3"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "config": {
    "security": {
      "csp": true,
      "hsts": true,
      "nosniff": true,
      "xframe": true,
      "xss": true
    }
  }
}
